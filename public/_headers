# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=()

# No Content-Security-Policy here on purpose (do not add `connect-src 'self'`).
# WebLLM downloads model weights from https://huggingface.co (which redirects
# to the HuggingFace CDN) and the wasm runtime from
# https://raw.githubusercontent.com. A same-origin-only CSP would block both
# and break model loading entirely. The full allowlist, including the CDN
# redirect targets, can only be pinned down by observing real network traffic
# after deployment, so CSP is deferred to a follow-up issue instead of
# guessing it here (see issue #5).

/assets/*
  Cache-Control: public, max-age=31536000, immutable
